{
  "title": "Prefix unknown keywords with x-",
  "description": "Future versions of JSON Schema will refuse to evaluate unknown keywords or custom keywords from optional vocabularies that don't have an x- prefix.",
  "examples": [
    {
      "after": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "x-fooBar": true
      },
      "before": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "fooBar": true
      },
      "doc": true
    },
    {
      "before": {
        "type": "string",
        "baz": 123
      }
    }
  ],
  "autofixable": true,
  "categories": [ "correctness", "readability" ],
  "dialects": {
    "2019-09": [],
    "2020-12": [],
    "draft4": [],
    "draft6": [],
    "draft7": []
  },
  "message": "Prefix unknown keyword(s) with \"x-\".",
  "references": [
    "https://json-schema.org/draft/2020-12/json-schema-core.html#rfc.section.4.4.4"
  ]
}
