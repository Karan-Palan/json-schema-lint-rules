{
  "title": "Remove empty `properties` object",
  "description": "Setting the `properties` keyword to the empty object does not add any further constraint.",
  "examples": [
    {
      "after": {
        "type": "object"
      },
      "before": {
        "type": "object",
        "properties": {}
      },
      "doc": true
    },
    {
      "after": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object"
          }
        ]
      },
      "before": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "properties": {}
          }
        ]
      }
    },
    {
      "after": {
        "allOf": [
          {
            "type": "object"
          }
        ]
      },
      "before": {
        "allOf": [
          {
            "type": "object",
            "properties": {}
          }
        ]
      }
    }
  ],
  "autofixable": true,
  "categories": [ "style" ],
  "dialects": {
    "2019-09": [ "properties" ],
    "2020-12": [ "properties" ],
    "draft4": [ "properties" ],
    "draft6": [ "properties" ],
    "draft7": [ "properties" ]
  },
  "message": "Delete the empty `properties` object.",
  "references": [
    "https://json-schema.org/understanding-json-schema/reference/object.html#properties"
  ]
}
