{
  "title": "Omit `unevaluatedItems:true/{}` (default behaviour)",
  "description": "Setting the `unevaluatedItems` keyword to the true schema does not add any further constraint.",
  "examples": [
    {
      "after": {
        "type": "array",
        "items": {
          "type": "integer"
        }
      },
      "before": {
        "type": "array",
        "items": {
          "type": "integer"
        },
        "unevaluatedItems": {}
      },
      "doc": true
    },
    {
      "after": {
        "type": "object",
        "properties": {
          "numbers": {
            "type": "array"
          }
        }
      },
      "before": {
        "type": "object",
        "properties": {
          "numbers": {
            "type": "array",
            "unevaluatedItems": true
          }
        }
      }
    }
  ],
  "autofixable": true,
  "categories": [ "style" ],
  "dialects": {
    "2020-12": [ "unevaluatedItems" ]
  },
  "message": "Remove redundant `unevaluatedItems`.",
  "references": [
    "https://json-schema.org/draft/2020-12/json-schema-validation.html#name-unevaluateditems"
  ]
}
